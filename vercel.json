{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.dealz.website"
        }
      ],
      "destination": "https://dealz.website/:path*",
      "permanent": true
    },
    {
      "source": "/crm",
      "destination": "/crm/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/crm/",
      "destination": "https://dealz-crm.vercel.app/"
    },
    {
      "source": "/crm/:path+",
      "destination": "https://dealz-crm.vercel.app/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 6 * * *"
    }
  ]
}
