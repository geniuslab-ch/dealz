# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# claude-haiku-4-5 is the cost-efficient default for this use case (~$0.01-0.02 per
# conversation). Swap to claude-sonnet-5 or claude-opus-5 if you need stronger reasoning.
CLAUDE_MODEL=claude-haiku-4-5

# Set to "true" to try the full demo (questions -> quote -> accept/refuse) with NO Anthropic
# API key and NO credit at all. Runs a small scripted conversation instead of calling Claude.
MOCK_MODE=false

PORT=3000

# Where decline/booking notifications go for the demo company. In a real
# multi-tenant deployment this would come from each client's config instead.
COMPANY_NOTIFY_EMAIL=reservations@swissclean.demo

# Public URL this server is reachable at — used to build the counteroffer/
# offer links sent by email. Set to your real deployed URL in production.
APP_BASE_URL=http://localhost:3000

# --- Email sending (optional) ---
# Leave SMTP_HOST empty to run in "dry run" mode: emails are logged to the
# server console instead of sent, so the whole decline -> counteroffer ->
# accept loop can be tested with zero email credentials. Set these to send
# real email (any SMTP provider works — Gmail app password, Resend, Postmark,
# your own mail server, etc.):
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Lead-capture gate on the public demo (optional) ---
# The demo (docs/demo.html) asks for a professional e-mail before revealing
# the chat widget, and caps how many times the same e-mail can try it — see
# src/leads.js. Leave both empty to skip the gate entirely (fails open, no
# Supabase project required). Use the SERVICE ROLE key here, not the anon
# key — this only ever runs server-side, never sent to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Number of free trials per e-mail before the gate blocks further attempts.
DEMO_TRIAL_LIMIT=3

# --- Install-request notifications (docs/contact-flow.js's #contact flow) ---
# Where a "🚀 Nouvelle demande d'installation Dealz" e-mail goes when
# someone completes the install-request flow. Defaults to
# dealz@mycountryisgoodat.com if unset.
DEALZ_TEAM_EMAIL=dealz@mycountryisgoodat.com

# --- Forward install-requests and demo usage into the CRM (optional) ---
# Leave these empty to skip — the notification e-mail above still sends,
# and the demo's lead-gate still works, either way. CRM_INBOUND_SECRET is
# shared by both forwards below and must match that CRM project's own
# INBOUND_LEAD_SECRET exactly.
CRM_INBOUND_URL=
CRM_DEMO_TESTED_URL=
CRM_REFERRAL_URL=
CRM_REFERRAL_IDENTIFY_URL=
CRM_INBOUND_SECRET=

# --- WhatsApp channel (optional) — Meta WhatsApp Cloud API ---
# Lets the same quote engine as the website chat run over WhatsApp, for
# cleaning companies whose customers' quote requests come in that way.
# Meta's Cloud API itself has no platform fee (no Twilio/BSP needed), and
# every message here is a customer-initiated reply within Meta's free
# "service" category — not billed at all, regardless of conversation length.
# Leave WHATSAPP_ACCESS_TOKEN empty to run in "dry run" mode: replies are
# logged to the server console instead of sent.
#
# Multi-tenant: every cleaning company's own WhatsApp number lives under ONE
# Meta Business Account (WABA) and shares this ONE access token — you don't
# need a separate token or Meta app per client. See src/companies.js for how
# each number's own name + pricing grid is registered, and the onboarding
# steps for adding a new client's number.
#
# Setup for the FIRST number (in Meta's developer dashboard,
# developers.facebook.com):
#   1. Create a Meta App (type: Business) and add the "WhatsApp" product.
#   2. Under WhatsApp > API Setup you'll get a temporary access token and a
#      "Phone number ID" for the free test number — good enough to try this
#      end to end before doing business verification for a real number.
#      Put that Phone number ID here as WHATSAPP_PHONE_NUMBER_ID (this is
#      only ever used as the fallback/first company — see src/companies.js).
#   3. Under WhatsApp > Configuration, set the webhook URL to
#      https://<your-deployed-domain>/api/whatsapp/webhook and the
#      "Verify token" to any string you choose — put that same string in
#      WHATSAPP_VERIFY_TOKEN below. Subscribe to the "messages" field.
#   4. For a permanent token (the temporary one expires in 24h), create a
#      System User under Business Settings > Users > System Users, assign it
#      the WhatsApp app, and generate a token with whatsapp_business_messaging
#      + whatsapp_business_management permissions, no expiry — this token
#      works for every number added to the WABA afterwards too.
#   5. Under App Settings > Basic, copy the "App Secret" into
#      WHATSAPP_APP_SECRET — this lets the webhook verify requests really
#      came from Meta (recommended; the endpoint still works without it, but
#      accepts unsigned requests from anyone until it's set).
#
# Adding a SECOND (or third, etc.) client's number: no new Meta app or
# token needed — add their number to the same WABA in WhatsApp Manager
# (business.facebook.com/wa/manage), then add an entry for it in
# src/companies.js with their own name + pricing grid. See that file's
# top-of-file comment for the full step-by-step.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Powers the no-signup "Essayer sur WhatsApp" card on docs/demo.html — a
# prospect just messages this number on their own WhatsApp and gets the
# same trial experience as the website chat demo, no email/form required.
# Must be the SAME physical number as WHATSAPP_PHONE_NUMBER_ID above, just
# written as plain public digits (country code + number, no +, no spaces —
# e.g. a Swiss number 079 123 45 67 becomes 41791234567) instead of Meta's
# internal id. Leave empty to keep the WhatsApp option hidden on the demo
# page until a real trial number is set up.
WHATSAPP_TRIAL_NUMBER_E164=
WHATSAPP_API_VERSION=v21.0
