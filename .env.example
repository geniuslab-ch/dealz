# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# claude-haiku-4-5 is the cost-efficient default for this use case (~$0.01-0.02 per
# conversation). Swap to claude-sonnet-5 or claude-opus-5 if you need stronger reasoning.
CLAUDE_MODEL=claude-haiku-4-5

# Set to "true" to try the full demo (questions -> quote -> accept/refuse) with NO Anthropic
# API key and NO credit at all. Runs a small scripted conversation instead of calling Claude.
MOCK_MODE=false

PORT=3000
