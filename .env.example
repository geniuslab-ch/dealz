# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# claude-haiku-4-5 is the cost-efficient default for this use case (~$0.01-0.02 per
# conversation). Swap to claude-sonnet-5 or claude-opus-5 if you need stronger reasoning.
CLAUDE_MODEL=claude-haiku-4-5

# Set to "true" to try the full demo (questions -> quote -> accept/refuse) with NO Anthropic
# API key and NO credit at all. Runs a small scripted conversation instead of calling Claude.
MOCK_MODE=false

PORT=3000

# Where decline/booking notifications go for the demo company. In a real
# multi-tenant deployment this would come from each client's config instead.
COMPANY_NOTIFY_EMAIL=reservations@swissclean.demo

# Public URL this server is reachable at — used to build the counteroffer/
# offer links sent by email. Set to your real deployed URL in production.
APP_BASE_URL=http://localhost:3000

# --- Email sending (optional) ---
# Leave SMTP_HOST empty to run in "dry run" mode: emails are logged to the
# server console instead of sent, so the whole decline -> counteroffer ->
# accept loop can be tested with zero email credentials. Set these to send
# real email (any SMTP provider works — Gmail app password, Resend, Postmark,
# your own mail server, etc.):
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Lead-capture gate on the public demo (optional) ---
# The demo (docs/demo.html) asks for a professional e-mail before revealing
# the chat widget, and caps how many times the same e-mail can try it — see
# src/leads.js. Leave both empty to skip the gate entirely (fails open, no
# Supabase project required). Use the SERVICE ROLE key here, not the anon
# key — this only ever runs server-side, never sent to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Number of free trials per e-mail before the gate blocks further attempts.
DEMO_TRIAL_LIMIT=3

# --- Install-request notifications (docs/contact-flow.js's #contact flow) ---
# Where a "🚀 Nouvelle demande d'installation Dealz" e-mail goes when
# someone completes the install-request flow. Defaults to
# dealz@mycountryisgoodat.com if unset.
DEALZ_TEAM_EMAIL=dealz@mycountryisgoodat.com

# --- Forward install-requests and demo usage into the CRM (optional) ---
# Leave these empty to skip — the notification e-mail above still sends,
# and the demo's lead-gate still works, either way. CRM_INBOUND_SECRET is
# shared by both forwards below and must match that CRM project's own
# INBOUND_LEAD_SECRET exactly.
CRM_INBOUND_URL=
CRM_DEMO_TESTED_URL=
CRM_INBOUND_SECRET=
